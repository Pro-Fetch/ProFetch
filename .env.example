# pro-fetch-mcp — environment reference
#
# Copy to `.env` or (recommended on Windows) set these as USER environment variables.
# NEVER commit real secrets. Every secret below may alternatively be supplied as
# <NAME>_FILE=<path to a local file containing only the value> (max 16 KiB).
# Empty values mean "not configured".

# ── Profile / tool visibility ────────────────────────────────────────────────
# smart (5 meta-tools, default in mcp.json) | minimal | standard (default) | full
PRO_FETCH_PROFILE=smart
# true => hard gate: block any tool not visible in the current profile. Incompatible with `smart`
# (which reaches non-visible tools through meta-executors) — use with minimal/standard/full.
PRO_FETCH_ENFORCE_PROFILE=
# 1 => print schema-narrowing stats (narrowed/skipped/resolved) to stderr at startup (diagnostics)
PRO_FETCH_LOG_NARROWING=

# Ixtiyoriy chegara: pro_fetch_profile_switch shu profildan o'ta olmaydi.
# Bo'sh qoldirilsa — operator buyrug'i amal qiladi: "full rejimga o't" desa o'tadi.
# Masalan: PRO_FETCH_PROFILE_CEILING=standard
# PRO_FETCH_PROFILE_CEILING=

# ── Safety policy ────────────────────────────────────────────────────────────
# true => block every mutating tool and every non-GET/HEAD/OPTIONS HTTP method
PRO_FETCH_READ_ONLY=
# Comma-separated tool names allowed even in read-only mode
PRO_FETCH_MUTATION_ALLOWLIST=
# Comma-separated policy lists (tool names / category names)
PRO_FETCH_ALLOWED_TOOLS=
PRO_FETCH_DENIED_TOOLS=
PRO_FETCH_DENIED_CATEGORIES=
# Files written via output_path / storage_state_path must live under this directory
PRO_FETCH_OUTPUT_ROOT=
# Required to run `npm test` / `npm build` tools (still needs confirm=true per call)
PRO_FETCH_ALLOW_COMMANDS=
# Required for browser evaluate/execute/script tools (run arbitrary page JavaScript)
PRO_FETCH_ALLOW_JS=
# Relax network hardening (leave unset unless you know you need them)
PRO_FETCH_ALLOW_HTTPS_DOWNGRADE=
PRO_FETCH_ALLOW_UNPINNED_PROXY_DNS=
# Without this, pro-fetch RE-ENABLES TLS certificate verification at boot even if the inherited
# environment set NODE_TLS_REJECT_UNAUTHORIZED=0 (some desktop/agent environments do). Set to true only
# for a trusted local network with self-signed certificates: it means any certificate is accepted, which
# is a loss of security, not a performance setting. The server warns on every boot while it is set.
PRO_FETCH_ALLOW_INSECURE_TLS=

# ── Limits ───────────────────────────────────────────────────────────────────
PRO_FETCH_TOOL_TIMEOUT_MS=180000
# After a tool timeout, how long its concurrency slots stay reserved while the
# handler is still running before they are force-released (default 30000)
PRO_FETCH_ABANDON_GRACE_MS=30000
PRO_FETCH_MAX_CONCURRENCY=32
PRO_FETCH_MAX_CATEGORY_CONCURRENCY=8
PRO_FETCH_MAX_NETWORK_CONCURRENCY=32
PRO_FETCH_MAX_PER_HOST_CONCURRENCY=4
PRO_FETCH_MAX_INPUT_BYTES=2097152
PRO_FETCH_MAX_BYTES=
PRO_FETCH_TIMEOUT_MS=
PRO_FETCH_COMMAND_TIMEOUT_MS=30000
PRO_FETCH_BROWSER_MAX_SESSIONS=
PRO_FETCH_GITHUB_MAX_PAGES=5

# ── Batch / capacity (MODE) ──────────────────────────────────────────────────
# Empty = Simple (default). max | full | unlimited = MAX mode: raises composite/batch capacity.
# MAX mode does NOT relax SSRF, sandbox or key protection — those are measurement, not toggles.
PRO_FETCH_MODE=
# Explicit per-call batch ceiling. Unset: Simple caps at 5000; MAX mode is effectively unbounded.
PRO_FETCH_MAX_BATCH=

# ── Paths ────────────────────────────────────────────────────────────────────
PRO_FETCH_CACHE_DIR=.pro-fetch-cache
PRO_FETCH_HTTP_CACHE_TTL_MS=
# Root for local git/devops/database/storage tools (defaults to the process cwd)
PRO_FETCH_WORKSPACE=
PRO_FETCH_SQLITE_PATH=
PRO_FETCH_KNOWLEDGE_DB=
# SQLite file for the persistent crawl queue (pro_fetch_crawl_job): the owed/paid rows and the document
# ids used for content dedupe. Default: ~/.pro-fetch/crawl-queue.sqlite
PRO_FETCH_CRAWL_DB=
# Playwright build to drive: chrome | msedge | chromium | firefox | webkit
# Empty = Playwright's own bundled build.
PRO_FETCH_BROWSER_CHANNEL=
# IANA timezone applied to browser contexts, for example Europe/Tashkent.
# Empty = the host timezone.
PRO_FETCH_BROWSER_TZ=
# Re-read an HTML shell (a 200 whose text arrives only after its scripts run) in a headless browser.
# Default: on. Set 0 or false to keep every answer purely HTTP — cheaper and faster, but a
# JavaScript-rendered page then comes back empty, and the answer will say so instead of guessing.
PRO_FETCH_BROWSER_ESCALATION=
# How many Chromium processes the pool may keep alive between rendered reads. Each is a process worth
# hundreds of megabytes, so this is the memory knob, not a speed knob; MAX mode cannot lift it past 8.
# Default 2.
PRO_FETCH_BROWSER_POOL_SIZE=
# Reads one process may serve before it is closed and a fresh one started. Chromium keeps memory it has
# taken; a restart is cheaper than an out-of-memory runner. Default 50.
PRO_FETCH_BROWSER_POOL_MAX_PAGES=
# A process nobody has touched for this long is closed on the next acquisition (there is no timer).
# Default 60000 ms.
PRO_FETCH_BROWSER_POOL_IDLE_MS=
# How long a caller waits when every process is busy before the call is refused with
# BRAUSER_HAVZASI_TOYIB. Default 30000 ms.
PRO_FETCH_BROWSER_POOL_WAIT_MS=
# Sub-resources a TEXT reader refuses instead of fetching. Default: image,media,font — a read whose purpose
# is the page's text cannot use them. `none` turns it off. Naming `script`, `xhr`, `fetch` or `stylesheet`
# is honoured but changes what the page SAYS, not merely how fast it arrives: those are how a rendered page
# gets its data, and innerText depends on layout. Interactive browser tools (screenshots, sessions) never
# inherit this default.
PRO_FETCH_BLOCK_RESOURCES=

# ── Identity (what a remote host sees) ───────────────────────────────────────
# Where a site operator can reach the people behind the traffic. The server sends
# `pro-fetch-mcp/<version> (+<this URL>)` as its User-Agent; the default is this project's repository.
# Set it to your own page when crawling on behalf of a company — a crawler with no contact cannot be told
# anything when it is too fast or refused. Must be a URL: the header is a token grammar, so free text with
# spaces would be rejected rather than read.
PRO_FETCH_USER_AGENT_CONTACT=

# ── Proxy (standard variables are honoured) ──────────────────────────────────
HTTP_PROXY=
HTTPS_PROXY=
ALL_PROXY=
NO_PROXY=

# ── Credentials (leave empty in version control) ─────────────────────────────
# Any credential may instead be supplied as <NAME>_FILE=<path>. A relative path is
# resolved against the package root, not the process working directory, so it keeps
# working regardless of where the MCP client spawns the server. `.secrets/` is
# git-ignored and is the recommended location for local secret files.
#
#   JIRA_TOKEN_FILE=.secrets/JIRA_TOKEN.txt
#
# GitHub (REST tools, code search, release monitoring)
GITHUB_TOKEN=
GITHUB_CLIENT_ID=
# Web search — 23 engine. Hech qaysi kalit bo'lmasa ham ishlaydi: kalitsiz engine'lar
# (DuckDuckGo, Hacker News, Wikipedia, npm, iTunes, OpenAlex, Crossref, arXiv, PubMed, Europe PMC,
# DOAJ, Google News) so'raladi. Qaysi biri hozir ishlatishga tayyor — pro_fetch_search_engines.
SERPER_API_KEY=
SEARCH_API_KEY=
TAVILY_API_KEY=
EXA_API_KEY=
SERPAPI_API_KEY=
LINKUP_API_KEY=
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
GOOGLE_API_KEY=
GOOGLE_CSE_ID=
PERPLEXITY_API_KEY=
# O'zingiz sozlagan SearXNG instansiyasi (format=json yoqilgan bo'lishi shart).
# Public misollar kalitsiz JSON bermaydi: searx.be JS tekshiruviga, priv.au 403 bilan javob berdi.
SEARXNG_URL=
YOUTUBE_API_KEY=

# OpenAI-compatible endpoint for embeddings / media tools
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_EMBEDDINGS_BASE_URL=
OPENAI_EMBEDDING_MODEL=

# Code hosts (MAX codehost pack)
GITLAB_TOKEN=
GITEA_TOKEN=
FORGEJO_TOKEN=
BITBUCKET_TOKEN=

# Collaboration
SLACK_BOT_TOKEN=
LINEAR_API_KEY=
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_TOKEN=
NOTION_TOKEN=

# Storage / productivity
DROPBOX_TOKEN=
GOOGLE_DRIVE_TOKEN=
MICROSOFT_GRAPH_TOKEN=
GOOGLE_ACCESS_TOKEN=
GMAIL_TOKEN=
TODOIST_API_TOKEN=

# Databases (MAX database pack; connection strings contain secrets)
DATABASE_URL=
POSTGRES_URL=
MYSQL_URL=
REDIS_URL=
# Optional exact host allowlist for self-hosted GitLab/Gitea/Forgejo/Bitbucket APIs.
# Comma-separated hostnames only, without scheme or path. Empty means official defaults only.
PRO_FETCH_ALLOWED_CODEHOST_HOSTS=
